# A pattern without `**/` matches only at the root of the build context, which
# is why `tests/` and `e2e/` used to ship: they live under server/ and console/.

# Git
.git
.gitignore
.github

# Node
**/node_modules
**/npm-debug.log
**/pnpm-debug.log

# Python
**/__pycache__
**/*.py[cod]
**/*.so
**/*.egg
**/*.egg-info
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.venv
**/venv
.coverage
htmlcov

# Environment files
**/.env
**/.env.local
**/.env.*.local
!server/.env.test

# IDE
.vscode
.idea
**/*.sw[op]
*~

# OS
.DS_Store
Thumbs.db

# Runtime state: the data directory is a mounted volume
data/
**/test-config.db
**/test-bucket

# Build artifacts: the console is built inside the image
console/dist
console/.vite

# Tests and their tooling, none of which runs in the image
**/tests
**/e2e
**/playwright.config.ts
**/playwright-report
**/test-results
**/*.test.ts
**/*.test.tsx
**/*.spec.ts

# Documentation
*.md
!README.md
